---
config:
  layout: dagre
  theme: base
  themeVariables:
    background: "#ffffff"
    primaryTextColor: "#111827"
    lineColor: "#475569"
    textColor: "#111827"
---
flowchart LR
    User["👤 User/Customer"] -- request --> OrchestratorAgent["🤖 Orchestrator Agent"]
    OrchestratorAgent -- response --> User

    OrchestratorNotes["Responsibilities:<br>• Single contact point for customer requests<br>• Analyze incoming requests<br>• Dispatch tasks to specialized agents<br>• Synthesize agent answers<br>• Create the final customer answer<br>• Limits per run: max 10 subagent calls, max 50 tool calls (soft limit)"] -.-> OrchestratorAgent
    InventoryNotes["Responsibilities:<br>• Track company inventory<br>• Answer inventory-related questions<br>• Check whether goods requests can be fulfilled<br>• Assess reorder needs<br>• Place explicitly requested stock reorders<br>• max 10 steps, max 50 tool calls per run"] -.-> InventoryAgent["📦 Inventory Manager Agent"]
    QuoteNotes["Responsibilities:<br>• Generate customer quotes, including pricing<br>• Apply bulk discounts<br>• max 6 steps, max 50 tool calls per run"] -.-> QuoteAgent["💰 Quote Generator Agent"]
    SalesNotes["Responsibilities:<br>• Finalize and register sales transactions<br>• Consider inventory levels and delivery timelines<br>• Report successful transaction execution<br>• max 12 steps, max 50 tool calls per run"] -.-> SalesAgent["🛒 Sales Agent"]
    ReportingNotes@{ shape: comment, label: "Responsibilities:<br/>• Monitor the company's financial situation<br/>• Report financial KPIs<br/>• max 6 steps, max 50 tool calls per run" } -.-> ReportingAgent["📊 Reporting Agent"]

    OrchestratorAgent <--> InventoryAgent
    OrchestratorAgent <--> QuoteAgent
    OrchestratorAgent <--> SalesAgent
    OrchestratorAgent <--> ReportingAgent

    OrchestratorAgent --> ToolResolveProduct["tool_resolve_product_name"] & ToolCalculator["tool_calculator"] & ToolParseDate["tool_parse_date"] & ToolCheckDeadline["tool_check_deadline"]
    InventoryAgent --> ToolCheckInventory["tool_check_inventory"] & ToolCheckStockLevel["tool_check_stock_level"] & ToolCheckDeliveryTimeline["tool_check_delivery_timeline"] & ToolGetUnitPrice["tool_get_unit_price"] & ToolCalculator & ToolExecuteOrder["tool_execute_order"]
    QuoteAgent --> ToolReadQuoteHistory["tool_read_quote_history"] & ToolGetUnitPrice & ToolCalculator
    SalesAgent --> ToolExecuteOrder & ToolCheckStockLevel & ToolCalculator
    ReportingAgent --> ToolGetCashBalance["tool_get_cash_balance"] & ToolGenerateReport["tool_generate_financial_report"] & ToolCalculator

    ToolResolveProduct --> FuncResolveProductName["_resolve_product_name (paper_supplies catalog, aliases, fuzzy matching)"]
    ToolCalculator --> FuncEval["_eval_node (safe arithmetic evaluator)"]
    ToolParseDate --> FuncParseDate["_parse_date_text"]
    ToolCheckDeadline --> FuncParseDate
    ToolGetUnitPrice -->|"inventory lookup"| Database
    ToolGetUnitPrice -->|"fallback"| ProductCatalog["📚 paper_supplies<br>(product catalog)"]
    FuncResolveProductName --> ProductCatalog
    ToolCheckInventory --> FuncGetAllInventory["get_all_inventory"]
    ToolCheckStockLevel --> FuncGetStockLevel["get_stock_level"]
    ToolCheckDeliveryTimeline --> FuncGetSupplierDeliveryDate["get_supplier_delivery_date"]
    ToolReadQuoteHistory --> FuncSearchQuoteHistory["search_quote_history"]
    ToolExecuteOrder --> FuncCreateTransaction["create_transaction"]
    ToolGetCashBalance --> FuncGetCashBalance["get_cash_balance"]
    ToolGenerateReport --> FuncGenerateFinancialReport["generate_financial_report"]

    FuncGetAllInventory --> Database[("🗄️ Database")]
    FuncGetStockLevel --> Database
    FuncSearchQuoteHistory --> Database
    FuncGetSupplierDeliveryDate --> Database
    FuncCreateTransaction --> Database
    FuncGetCashBalance --> Database
    FuncGenerateFinancialReport --> Database

    OrchestratorNotes@{ shape: comment }
    InventoryNotes@{ shape: comment }
    QuoteNotes@{ shape: comment }
    SalesNotes@{ shape: comment }

    subgraph Legend["Legend"]
        direction LR
        LegendAgent["Blue = Agents"]
        LegendTool["Green = Tools"]
        LegendFunction["Yellow = System functions"]
    end

